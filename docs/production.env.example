APP_NAME=KONEK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://konek.example.edu.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=konek
DB_USERNAME=konek
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=konek_session
SESSION_DOMAIN=konek.example.edu.ph
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@konek.example.edu.ph
MAIL_FROM_NAME="${APP_NAME}"

KONEK_SEED_DEMO=false
KONEK_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
