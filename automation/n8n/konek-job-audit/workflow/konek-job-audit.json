      "id": "3a25e727-b8cd-4ea8-8fde-36c82a0b5753",
      "name": "KONEK Job Created Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1120,
        100
      ],
      "webhookId": "konek-job-created-audit"
